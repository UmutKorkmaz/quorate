{
  "openapi": "3.0.3",
  "info": {
    "title": "Tasks API",
    "version": "1.1.0",
    "description": "Minimal JSON variant of the Tasks API fixtures; demonstrates that quorate contract check parses JSON as well as YAML."
  },
  "servers": [
    {
      "url": "https://api.example.com/v1"
    }
  ],
  "paths": {
    "/tasks": {
      "get": {
        "operationId": "listTasks",
        "summary": "List tasks",
        "responses": {
          "200": {
            "description": "A list of tasks.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Task"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      },
      "post": {
        "operationId": "createTask",
        "summary": "Create a task",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Task created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "BadRequest": {
        "description": "Invalid request payload or parameters.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Task": {
        "type": "object",
        "description": "A single task.",
        "required": [
          "id",
          "title",
          "status"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "Numeric task identifier."
          },
          "title": {
            "type": "string",
            "description": "Short human-readable title."
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          },
          "dueDate": {
            "type": "string",
            "format": "date",
            "description": "Due date (YYYY-MM-DD)."
          }
        }
      },
      "TaskStatus": {
        "type": "string",
        "description": "Lifecycle state of a task.",
        "enum": [
          "todo",
          "in_progress",
          "done"
        ]
      },
      "TaskCreate": {
        "type": "object",
        "description": "Payload for creating a task.",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "Short human-readable title."
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          },
          "dueDate": {
            "type": "string",
            "format": "date",
            "description": "Due date (YYYY-MM-DD)."
          },
          "assignee": {
            "type": "string",
            "description": "Optional display name of the person responsible for the task."
          }
        }
      },
      "Error": {
        "type": "object",
        "description": "Machine-readable error payload.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable error code, e.g. \"task_not_found\"."
          },
          "message": {
            "type": "string",
            "description": "Human-readable explanation."
          }
        }
      }
    }
  }
}
