diff --git a/app/src/legacy-blockhash.ts b/app/src/legacy-blockhash.ts
--- a/app/src/legacy-blockhash.ts
+++ b/app/src/legacy-blockhash.ts
@@ -1,3 +1,8 @@
+import { Connection } from "@solana/web3.js";
+
+export async function loadLegacyBlockhash(connection: Connection): Promise<string> {
+  const { blockhash } = await connection.getRecentBlockhash("confirmed");
+  const fees = await connection.getFeeCalculatorForBlockhash(blockhash, "confirmed");
+  return `${blockhash}:${fees.value?.lamportsPerSignature ?? ""}`;
+}
