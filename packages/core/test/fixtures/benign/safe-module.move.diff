diff --git a/sources/safe_registry.move b/sources/safe_registry.move
--- a/sources/safe_registry.move
+++ b/sources/safe_registry.move
@@ -0,0 +1,55 @@
+/// Safe registry — AdminCap-gated mutations, capability-scoped access.
+module safe_registry::registry {
+    use sui::object::{Self, UID};
+    use sui::transfer;
+    use sui::tx_context::{Self, TxContext};
+    use std::string::{Self, String};
+
+    // ── Capability — no copy, no drop ───────────────────────────────────────
+
+    struct AdminCap has key, store {
+        id: UID,
+    }
+
+    // ── Registry object ──────────────────────────────────────────────────────
+
+    struct Registry has key {
+        id: UID,
+        name: String,
+        entry_count: u64,
+    }
+
+    // ── Module setup — AdminCap issued to deployer.
+    // Called from a separate orchestrating function; not an implicit initializer.
+    // Uses 'setup' rather than 'init' (an init fn would be flagged as informational).
+
+    public fun setup(ctx: &mut TxContext) {
+        let cap = AdminCap { id: object::new(ctx) };
+        transfer::transfer(cap, tx_context::sender(ctx));
+    }
+
+    // ── Capability-gated function — AdminCap required ────────────────────────
+    // This is a plain public fun (not externally callable as an entry point)
+    // so callers must already hold the AdminCap token to invoke it.
+
+    public fun create_registry(
+        _cap: &AdminCap,
+        name_bytes: vector<u8>,
+        ctx: &mut TxContext
+    ) {
+        let caller = tx_context::sender(ctx);
+        assert!(caller != @0x0, 1);
+        let reg = Registry {
+            id: object::new(ctx),
+            name: string::utf8(name_bytes),
+            entry_count: 0,
+        };
+        transfer::transfer(reg, caller);
+    }
+
+    // ── Gated mutation — AdminCap required ──────────────────────────────────
+
+    public fun increment_count(_cap: &AdminCap, registry: &mut Registry) {
+        registry.entry_count = registry.entry_count + 1;
+    }
+
+    // ── Read-only accessor — no mutation, no capability required ────────────
+
+    public fun get_entry_count(registry: &Registry): u64 {
+        registry.entry_count
+    }
+}
