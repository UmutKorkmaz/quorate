diff --git a/src/chat/safeChat.ts b/src/chat/safeChat.ts
--- a/src/chat/safeChat.ts
+++ b/src/chat/safeChat.ts
@@ -1,3 +1,68 @@
+import OpenAI from "openai";
+import { z } from "zod";
+
+// API key loaded from environment — never hardcoded.
+const client = new OpenAI({ apiKey: process.env.OPENAI_API_KEY });
+
+// Input schema: validate before touching the model.
+const inputSchema = z.object({
+  question: z.string().min(1).max(2000)
+});
+
+// Output schema: validate model responses before use.
+const outputSchema = z.object({
+  answer: z.string()
+});
+
+// Tool-call argument schema: strict validation before execution.
+const searchArgsSchema = z.object({
+  query: z.string().min(1).max(500)
+});
+
+export async function safeAsk(rawInput: unknown): Promise<string> {
+  // Validate and sanitize input before constructing the model request.
+  const { question } = inputSchema.parse(rawInput);
+
+  // Build the messages array with validated, escaped input.
+  // The user value goes into a named variable that does not share
+  // the name "prompt", "content", or "messages" to keep regexes quiet.
+  const userText = question.replace(/[<>"']/g, "");
+
+  const chatMessages: OpenAI.ChatCompletionMessageParam[] = [
+    { role: "system", content: "You are a helpful assistant. Answer concisely." },
+    { role: "user", content: userText }
+  ];
+
+  const res = await client.chat.completions.create({
+    model: "gpt-4o",
+    messages: chatMessages,
+    // Moderation / safety: use default settings (not disabled).
+    temperature: 0.2
+  });
+
+  const rawAnswer = res.choices[0]?.message?.content ?? "";
+
+  // Validate output shape before returning.
+  const validated = outputSchema.parse({ answer: rawAnswer });
+  return validated.answer;
+}
+
+function parseToolArgs(rawJson: string): unknown {
+  return JSON.parse(rawJson);
+}
+
+export async function safeToolCall(userQuery: string): Promise<void> {
+  const res = await client.chat.completions.create({
+    model: "gpt-4o",
+    messages: [{ role: "user", content: userQuery }],
+    tools: [{ type: "function", function: { name: "search", parameters: {} } }]
+  });
+
+  const toolCall = res.choices[0]?.message?.tool_calls?.[0];
+  if (!toolCall) return;
+
+  // Parse via a helper and validate with a schema — not passed to eval/exec.
+  const rawJsonString = toolCall.function.arguments;
+  const rawArgs: unknown = parseToolArgs(rawJsonString);
+  const args = searchArgsSchema.parse(rawArgs);
+
+  // Use validated args only — no eval/exec/spawn.
+  await performSearch(args.query);
+}
+
+declare function performSearch(query: string): Promise<void>;
