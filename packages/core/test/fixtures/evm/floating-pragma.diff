diff --git a/contracts/Token.sol b/contracts/Token.sol
--- a/contracts/Token.sol
+++ b/contracts/Token.sol
@@ -1,3 +1,10 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.0;
+
+contract Token {
+    mapping(address => uint256) public balances;
+
