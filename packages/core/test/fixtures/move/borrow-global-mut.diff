diff --git a/sources/registry.move b/sources/registry.move
--- a/sources/registry.move
+++ b/sources/registry.move
@@ -1,3 +1,20 @@
+module registry::registry {
+    use aptos_framework::signer;
+
+    struct Config has key {
+        admin: address,
+        fee_bps: u64,
+    }
+
+    public fun update_fee(account: &signer, new_fee: u64, target: address) acquires Config {
+        // target is attacker-supplied; no check that target == signer::address_of(account)
+        let config = borrow_global_mut<Config>(target);
+        config.fee_bps = new_fee;
+        let _ = account;
+    }
+}
