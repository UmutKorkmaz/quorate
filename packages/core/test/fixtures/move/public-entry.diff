diff --git a/sources/vault.move b/sources/vault.move
--- a/sources/vault.move
+++ b/sources/vault.move
@@ -1,3 +1,18 @@
+module vault::vault {
+    use sui::object::{Self, UID};
+    use sui::transfer;
+    use sui::tx_context::{Self, TxContext};
+
+    struct Vault has key {
+        id: UID,
+        balance: u64,
+    }
+
+    public entry fun withdraw_all(vault: &mut Vault, ctx: &mut TxContext) {
+        // Missing signer authorization check — any caller can withdraw
+        let amount = vault.balance;
+        vault.balance = 0;
+        let _ = amount;
+        let _ = ctx;
+    }
+}
