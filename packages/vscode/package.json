{
  "name": "quorate-vscode",
  "displayName": "Quorate — AI Review Council",
  "description": "Convene Quorate's multi-agent AI review council on your current change, right inside VS Code.",
  "version": "0.4.0",
  "publisher": "umutkorkmaz",
  "private": true,
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": { "color": "#0b0f17", "theme": "dark" },
  "repository": {
    "type": "git",
    "url": "https://github.com/UmutKorkmaz/quorate.git",
    "directory": "packages/vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Linters", "SCM Providers", "Other"],
  "keywords": ["ai", "code review", "council", "pr review", "quorate"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "quorate", "title": "Quorate", "icon": "media/quorate.svg" }
      ]
    },
    "views": {
      "quorate": [
        { "id": "quorate.council", "name": "Council" },
        { "id": "quorate.results", "name": "Results" },
        { "id": "quorate.status", "name": "Status", "visibility": "collapsed" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "quorate.council",
        "contents": "Quorate CLI not found.\n[Install (npm i -g quorate)](command:quorate.installCli)\n[Set CLI path](command:quorate.openSettings)",
        "when": "!quorate.cliReady"
      },
      {
        "view": "quorate.council",
        "contents": "Open a folder to review changes.\n[Open Folder](command:vscode.openFolder)",
        "when": "quorate.cliReady && !quorate.hasWorkspace"
      },
      {
        "view": "quorate.council",
        "contents": "No council config yet.\n[Run quorate init](command:quorate.init)\n[Open Settings](command:quorate.openSettings)",
        "when": "quorate.cliReady && quorate.hasWorkspace && !quorate.hasConfig"
      },
      {
        "view": "quorate.results",
        "contents": "No review yet.\n[Run Review](command:quorate.run)\nPick a diff source in the Council view, then convene the council.",
        "when": "quorate.cliReady"
      }
    ],
    "commands": [
      { "command": "quorate.run", "title": "Run Review", "category": "Quorate", "icon": "$(play)" },
      { "command": "quorate.pickDiffSource", "title": "Change Diff Source", "category": "Quorate", "icon": "$(git-compare)" },
      { "command": "quorate.refresh", "title": "Refresh", "category": "Quorate", "icon": "$(refresh)" },
      { "command": "quorate.addProvider", "title": "Add Provider…", "category": "Quorate", "icon": "$(add)" },
      { "command": "quorate.removeProvider", "title": "Remove Provider", "category": "Quorate", "icon": "$(trash)" },
      { "command": "quorate.editRoles", "title": "Edit Roles…", "category": "Quorate", "icon": "$(gear)" },
      { "command": "quorate.openConfig", "title": "Open .quorate.yml", "category": "Quorate", "icon": "$(go-to-file)" },
      { "command": "quorate.openSettings", "title": "Open Settings", "category": "Quorate", "icon": "$(settings-gear)" },
      { "command": "quorate.init", "title": "Run quorate init", "category": "Quorate" },
      { "command": "quorate.installCli", "title": "Install Quorate CLI", "category": "Quorate" },
      { "command": "quorate.runDoctor", "title": "Re-run Doctor", "category": "Quorate", "icon": "$(refresh)" },
      { "command": "quorate.openFinding", "title": "Open Finding", "category": "Quorate" },
      { "command": "quorate.clearFindings", "title": "Clear Findings", "category": "Quorate", "icon": "$(clear-all)" },
      { "command": "quorate.setKey", "title": "Set API Key…", "category": "Quorate", "icon": "$(key)" },
      { "command": "quorate.fixFinding", "title": "Fix Finding with Agent…", "category": "Quorate", "icon": "$(wrench)" },
      { "command": "quorate.revertFix", "title": "Revert Last Fix", "category": "Quorate", "icon": "$(discard)" },
      { "command": "quorate.suppressFinding", "title": "Ignore Finding (// quorate-ignore)", "category": "Quorate", "icon": "$(eye-closed)" },
      { "command": "quorate.setupPack", "title": "Set Up Domain Pack…", "category": "Quorate", "icon": "$(extensions)" }
    ],
    "menus": {
      "view/title": [
        { "command": "quorate.run", "when": "view == quorate.council && quorate.cliReady", "group": "navigation@1" },
        { "command": "quorate.pickDiffSource", "when": "view == quorate.council", "group": "navigation@2" },
        { "command": "quorate.refresh", "when": "view == quorate.council", "group": "navigation@3" },
        { "command": "quorate.setupPack", "when": "view == quorate.council", "group": "1_config@1" },
        { "command": "quorate.addProvider", "when": "view == quorate.council", "group": "1_config@2" },
        { "command": "quorate.openConfig", "when": "view == quorate.council", "group": "1_config@3" },
        { "command": "quorate.openSettings", "when": "view == quorate.council", "group": "1_config@4" },
        { "command": "quorate.clearFindings", "when": "view == quorate.results", "group": "navigation@1" },
        { "command": "quorate.revertFix", "when": "view == quorate.results", "group": "1_fix@1" },
        { "command": "quorate.runDoctor", "when": "view == quorate.status", "group": "navigation@1" }
      ],
      "view/item/context": [
        { "command": "quorate.setKey", "when": "view == quorate.council && viewItem == providerApi", "group": "inline@1" },
        { "command": "quorate.editRoles", "when": "view == quorate.council && viewItem =~ /^provider(Api)?$/", "group": "inline@2" },
        { "command": "quorate.removeProvider", "when": "view == quorate.council && viewItem =~ /^provider(Api)?$/", "group": "inline@3" },
        { "command": "quorate.fixFinding", "when": "view == quorate.results && viewItem == finding", "group": "inline@1" }
      ]
    },
    "configuration": {
      "title": "Quorate",
      "properties": {
        "quorate.cliPath": {
          "type": "string",
          "default": "quorate",
          "description": "Path to the quorate CLI, or just \"quorate\" if it is on your PATH (npm i -g quorate)."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "compile": "tsc --noEmit -p tsconfig.json",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --production && vsce package --no-dependencies",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.27.7",
    "typescript": "^5.9.3"
  }
}
