# Intentionally incomplete: replace empty required values through a private editor.
# Copy to /etc/quorate/app.env, root:quorate, mode 0640. Never commit real credentials.
APP_ID=
WEBHOOK_SECRET=
PRIVATE_KEY_PATH=/etc/quorate/private-key.pem
HOST=127.0.0.1
PORT=3296
QUORATE_APP_STATE_DIR=/var/lib/quorate/state
REVIEW_CONCURRENCY=2
# Select supported API providers in the repository's trusted base-branch .quorate.yml.
# Keep their keys in this private environment file, never in command lines or repository files.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
